@startuml
!include <C4/C4_Container>
skinparam defaultFontSize 12
skinparam backgroundColor #FFFFFF

title C4 Container Diagram — Africa Delivery (контейнеры по регионам, движение персональных данных)

Person(customer, "Покупатель", "")
Person(seller, "Продавец", "")

System_Boundary(za, "Регион: ЮАР/Кения (AWS af-south-1)") {
  Container(api, "API Gateway", "Go", "Маршрутизация и auth. НЕ хранит персональные данные — только token/request_id/trace_id")
  Container(catalog, "Сервис каталога", "Go + PostgreSQL", "Только публичные данные (товары, цены) — не персональные")
  Container(cache, "Redis (кеш)", "Redis", "Кеш каталога и сессий")
}

System_Boundary(ng, "Регион: Нигерия (локальный провайдер)") {
  Container(ngdb, "PostgreSQL (персональные данные)", "PostgreSQL", "Профили, транзакции и заказы нигерийцев — только здесь, реплика внутри страны")
  Container(ngsvc, "Сервисы нигерийского трафика", "Go", "Обработка заказов/оплаты Нигерии")
}

System_Boundary(ke, "Регион: Кения (локальная serving-копия)") {
  Container(kedb, "PostgreSQL (serving-копия)", "PostgreSQL", "Профили и платёжные данные кенийцев — локальная копия (KICA)")
}

System_Boundary(ext, "Внешние SaaS-партнёры") {
  System_Ext(mpesa, "M-Pesa", "Платежи, Кения")
  System_Ext(flutterwave, "Flutterwave", "Платежи, Нигерия")
  System_Ext(sendbox, "Sendbox / Sendy", "Логистика")
  System_Ext(smsgw, "SMS / USSD-шлюз", "Уведомления")
  System_Ext(whatsapp, "WhatsApp Business API", "Онбординг продавцов")
}

Rel(customer, api, "Запросы (token + request_id), не персональные данные")
Rel(seller, whatsapp, "Онбординг без кабинета")
Rel(api, catalog, "Публичный каталог")
Rel(catalog, cache, "Кеш товаров")
Rel(api, ngsvc, "Проксирует запрос, не складывая копию данных")
Rel(ngsvc, ngdb, "Запись/чтение персональных данных (только в Нигерии)")
Rel(ngsvc, flutterwave, "Платёж (Нигерия)")
Rel(ngsvc, sendbox, "Доставка (Нигерия)")
Rel(api, kedb, "Чтение кенийской serving-копии")
Rel(ngsvc, kedb, "Синхронизация кенийской serving-копии")
Rel(kedb, mpesa, "Платёж M-Pesa (Кения)")
Rel(api, smsgw, "Уведомления (обезличенный номер + шаблон)")
Rel(api, whatsapp, "Уведомления продавцу")
@enduml
